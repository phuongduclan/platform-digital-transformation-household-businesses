# Environment variables template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# Google AI Studio API Key
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_api_key_here
GOOGLE_AI_MODEL=gemini-1.5-flash
GOOGLE_AI_TEMPERATURE=0.2
GOOGLE_AI_MAX_TOKENS=2048

# Goong.io API Key (Vietnamese address autocomplete)
# Get your API key at: https://account.goong.io
GOONG_API_KEY=your_goong_api_key_here

# Database
DATABASE_URI=postgresql://postgres.xjghpmiupxldgezcrucj:079206043460@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Flask
SECRET_KEY=a_default_secret_key
